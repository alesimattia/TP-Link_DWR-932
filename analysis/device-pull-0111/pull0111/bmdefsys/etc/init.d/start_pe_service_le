# QCMAP_Web_CLIENT.   init.d script to start the Data Software's QCMAP_Web_CLIENT. daemon

set -e

case "$1" in
  start)
        echo -n "Starting pe_service: "
        start-stop-daemon -S -b -a /bmdefsys/usr/bin/pe_service
        echo "done"
        ;;
  stop)
        echo -n "Stopping pe_service: "
        start-stop-daemon -K -n /bmdefsys/usr/bin/pe_service
        echo "done"
        ;;
  restart)
        $0 stop
        $0 start
        ;;
  *)
        echo "Usage pe_service { start | stop | restart}" >&2
        exit 1
        ;;
esac

exit 0
