# deep_sleep_server   init.d script to start the Data Software's deep_sleep_server. daemon

set -e

case "$1" in
  start)
        echo -n "Starting bm_netstat: "
        start-stop-daemon -S -b -a /bmdefsys/usr/bin/bm_netstat
        start-stop-daemon -S -b -a /bmdefsys/usr/bin/bm_netrate
        echo "done"
        ;;
  stop)
        echo -n "Stopping bm_netstat: "
        start-stop-daemon -K -n /bmdefsys/usr/bin/bm_netstat
        start-stop-daemon -K -n /bmdefsys/usr/bin/bm_netrate
        echo "done"
        ;;
  restart)
        $0 stop
        $0 start
        ;;
  *)
        echo "Usage bm_netstat { start | stop | restart}" >&2
        exit 1
        ;;
esac

exit 0
