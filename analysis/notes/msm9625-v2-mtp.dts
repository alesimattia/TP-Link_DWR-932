			qcom,audio-routing = "RX_BIAS", "MCLK", "LDO_H", "MCLK", "Ext Spk Bottom Pos", "LINEOUT1", "Ext Spk Bottom Neg", "LINEOUT3", "Ext Spk Top Pos", "LINEOUT2", "Ext Spk Top Neg", "LINEOUT4", "AMIC1", "MIC BIAS1 External", "MIC BIAS1 External", "Handset Mic", "AMIC2", "MIC BIAS2 External", "MIC BIAS2 External", "Headset Mic", "AMIC3", "MIC BIAS3 Internal1", "MIC BIAS3 Internal1", "ANCRight Headset Mic", "AMIC4", "MIC BIAS1 Internal2", "MIC BIAS1 Internal2", "ANCLeft Headset Mic", "DMIC1", "MIC BIAS1 External", "MIC BIAS1 External", "Digital Mic1", "DMIC2", "MIC BIAS1 External", "MIC BIAS1 External", "Digital Mic2", "DMIC3", "MIC BIAS3 External", "MIC BIAS3 External", "Digital Mic3", "DMIC4", "MIC BIAS3 External", "MIC BIAS3 External", "Digital Mic4", "DMIC5", "MIC BIAS4 External", "MIC BIAS4 External", "Digital Mic5", "DMIC6", "MIC BIAS4 External", "MIC BIAS4 External", "Digital Mic6";
			qcom,taiko-mclk-clk-freq = <0xbb8000>;
			prim-i2s-gpio-ws = <0x02 0x0c 0x00>;
			prim-i2s-gpio-din = <0x02 0x0d 0x00>;
			prim-i2s-gpio-dout = <0x02 0x0e 0x00>;
			prim-i2s-gpio-sclk = <0x02 0x0f 0x00>;
			prim-i2s-gpio-mclk = <0x02 0x47 0x00>;
		};

		qcom,msm-adsp-loader {
			compatible = "qcom,adsp-loader";
			qcom,adsp-state = <0x02>;
		};

		qcom,msm-pcm {
			compatible = "qcom,msm-pcm-dsp";
			qcom,msm-pcm-dsp-id = <0x00>;
		};

		qcom,msm-pcm-routing {
			compatible = "qcom,msm-pcm-routing";
		};

		qcom,msm-compr-dsp {
			compatible = "qcom,msm-compr-dsp";
		};

		qcom,msm-voip-dsp {
			compatible = "qcom,msm-voip-dsp";
		};

		qcom,msm-pcm-voice {
			compatible = "qcom,msm-pcm-voice";
		};

		qcom,msm-stub-codec {
			compatible = "qcom,msm-stub-codec";
		};

		qcom,msm-dai-fe {
			compatible = "qcom,msm-dai-fe";
		};

		qcom,msm-pcm-afe {
			compatible = "qcom,msm-pcm-afe";
		};

		qcom,msm-pcm-hostless {
			compatible = "qcom,msm-pcm-hostless";
		};

		qcom,msm-voice-host-pcm {
			compatible = "qcom,msm-voice-host-pcm";
		};

		qcom,msm-dai-q6 {
			compatible = "qcom,msm-dai-q6";

			qcom,msm-dai-q6-be-afe-pcm-rx {
				compatible = "qcom,msm-dai-q6-dev";
				qcom,msm-dai-q6-dev-id = <0xe0>;
			};

			qcom,msm-dai-q6-be-afe-pcm-tx {
				compatible = "qcom,msm-dai-q6-dev";
				qcom,msm-dai-q6-dev-id = <0xe1>;
			};

			qcom,msm-dai-q6-afe-proxy-rx {
				compatible = "qcom,msm-dai-q6-dev";
				qcom,msm-dai-q6-dev-id = <0xf1>;
			};

			qcom,msm-dai-q6-afe-proxy-tx {
				compatible = "qcom,msm-dai-q6-dev";
				qcom,msm-dai-q6-dev-id = <0xf0>;
			};

			qcom,msm-dai-q6-incall-record-rx {
				compatible = "qcom,msm-dai-q6-dev";
				qcom,msm-dai-q6-dev-id = <0x8003>;
			};

			qcom,msm-dai-q6-incall-record-tx {
				compatible = "qcom,msm-dai-q6-dev";
				qcom,msm-dai-q6-dev-id = <0x8004>;
			};

			qcom,msm-dai-q6-incall-music-rx {
				compatible = "qcom,msm-dai-q6-dev";
				qcom,msm-dai-q6-dev-id = <0x8005>;
			};
		};

		qcom,msm-pcm-dtmf {
			compatible = "qcom,msm-pcm-dtmf";
		};

		qcom,msm-dai-stub {
			compatible = "qcom,msm-dai-stub";
		};

		qcom,msm-auxpcm {
			compatible = "qcom,msm-auxpcm-resource";
			qcom,msm-cpudai-auxpcm-clk = "pcm_clk";
			qcom,msm-cpudai-auxpcm-mode = <0x00 0x00>;
			qcom,msm-cpudai-auxpcm-sync = <0x01 0x01>;
			qcom,msm-cpudai-auxpcm-frame = <0x05 0x04>;
			qcom,msm-cpudai-auxpcm-quant = <0x02 0x02>;
			qcom,msm-cpudai-auxpcm-slot = <0x01 0x01>;
			qcom,msm-cpudai-auxpcm-data = <0x00 0x00>;
			qcom,msm-cpudai-auxpcm-pcm-clk-rate = <0x1f4000 0x1f4000>;

			qcom,msm-auxpcm-rx {
				qcom,msm-auxpcm-dev-id = <0x100a>;
				compatible = "qcom,msm-auxpcm-dev";
			};

			qcom,msm-auxpcm-tx {
				qcom,msm-auxpcm-dev-id = <0x100b>;
				compatible = "qcom,msm-auxpcm-dev";
			};
		};

		qcom,msm-dai-mi2s {
			compatible = "qcom,msm-dai-mi2s";

			qcom,msm-dai-q6-mi2s-prim {
				compatible = "qcom,msm-dai-q6-mi2s";
				qcom,msm-dai-q6-mi2s-dev-id = <0x00>;
				qcom,msm-mi2s-rx-lines = <0x02>;
				qcom,msm-mi2s-tx-lines = <0x01>;
			};
		};

		qcom,mss {
			compatible = "qcom,pil-q6v5-mss";
			interrupts = <0x00 0x18 0x01>;
			qcom,is-not-loadable;
			qcom,gpio-err-fatal = <0x24 0x00 0x00>;
			qcom,gpio-err-ready = <0x24 0x01 0x00>;
			qcom,gpio-proxy-unvote = <0x24 0x02 0x00>;
			qcom,gpio-stop-ack = <0x24 0x03 0x00>;
			qcom,gpio-force-stop = <0x25 0x00 0x00>;
		};

		qcom,smem@0 {
			compatible = "qcom,smem";
			reg = <0x00 0x100000 0xf9011000 0x1000 0xfc428000 0x4000>;
			reg-names = "smem", "irq-reg-base", "aux-mem1";

			qcom,smd-modem {
				compatible = "qcom,smd";
				qcom,smd-edge = <0x00>;
				qcom,smd-irq-offset = <0x08>;
				qcom,smd-irq-bitmask = <0x1000>;
				qcom,pil-string = "modem";
				interrupts = <0x00 0x19 0x01>;
			};

			qcom,smsm-modem {
				compatible = "qcom,smsm";
				qcom,smsm-edge = <0x00>;
				qcom,smsm-irq-offset = <0x08>;
				qcom,smsm-irq-bitmask = <0x2000>;
				interrupts = <0x00 0x1a 0x01>;
			};

			qcom,smd-adsp {
				compatible = "qcom,smd";
				qcom,smd-edge = <0x01>;
				qcom,smd-irq-offset = <0x08>;
				qcom,smd-irq-bitmask = <0x100>;
				qcom,pil-string = "adsp";
				interrupts = <0x00 0x9c 0x01>;
			};

			qcom,smsm-adsp {
				compatible = "qcom,smsm";
				qcom,smsm-edge = <0x01>;
				qcom,smsm-irq-offset = <0x08>;
				qcom,smsm-irq-bitmask = <0x200>;
				interrupts = <0x00 0x9d 0x01>;
			};

			qcom,smd-rpm {
				compatible = "qcom,smd";
				qcom,smd-edge = <0x0f>;
				qcom,smd-irq-offset = <0x08>;
				qcom,smd-irq-bitmask = <0x01>;
				interrupts = <0x00 0xa8 0x01>;
				qcom,irq-no-suspend;
			};
		};

		qcom,qcedev@fd400000 {
			compatible = "qcom,qcedev";
			reg = <0xfd400000 0x20000 0xfd404000 0x8000>;
			reg-names = "crypto-base", "crypto-bam-base";
			interrupts = <0x00 0xcf 0x00>;
			qcom,bam-pipe-pair = <0x01>;
		};

		qcom,qcrypto@fd440000 {
			compatible = "qcom,qcrypto";
			reg = <0xfd400000 0x20000 0xfd404000 0x8000>;
			reg-names = "crypto-base", "crypto-bam-base";
			interrupts = <0x00 0xcf 0x00>;
			qcom,bam-pipe-pair = <0x02>;
		};

		jtagmm@fc332000 {
			compatible = "qcom,jtag-mm";
			reg = <0xfc332000 0x1000 0xfc330000 0x1000>;
			reg-names = "etm-base", "debug-base";
		};

		qcom,msm-rtb {
			compatible = "qcom,msm-rtb";
			qcom,memory-reservation-type = "EBI1";
			qcom,memory-reservation-size = <0x1000>;
		};

		qcom,msm-mem-hole {
			compatible = "qcom,msm-mem-hole";
			qcom,memblock-remove = <0x1c00000 0x4c00000>;
		};

		qcom,ipc-spinlock@fd484000 {
			compatible = "qcom,ipc-spinlock-sfpb";
			reg = <0xfd484000 0x400>;
			qcom,num-locks = <0x08>;
			status = "disable";
		};

		qcom,ipc-spinlock@fa00000 {
			compatible = "qcom,ipc-spinlock-ldrex";
			reg = <0xfa00000 0x200000>;
			status = "ok";
		};

		cpu-pmu {
			compatible = "arm,cortex-a5-pmu";
			qcom,irq-is-percpu;
			interrupts = <0x01 0x07 0x00>;
		};

		l2-pmu {
			compatible = "qcom,l2-pmu";
			interrupts = <0x00 0x01 0x00>;
		};

		gpio_leds {
			compatible = "gpio-leds";

			signal_led_blue {
				label = "signal_led_blue";
				gpios = <0x02 0x41 0x00>;
				default-state = "off";
				retain-state-suspended;
			};

			signal_led_red {
				label = "signal_led_red";
				gpios = <0x02 0x42 0x00>;
				default-state = "off";
				retain-state-suspended;
			};

			signal_led_green {
				label = "signal_led_green";
				gpios = <0x02 0x43 0x00>;
				default-state = "off";
				retain-state-suspended;
			};

			power_led_blue {
				label = "power_led_blue";
				gpios = <0x02 0x07 0x00>;
				default-state = "off";
				retain-state-suspended;
			};

			power_led_red {
				label = "power_led_red";
				gpios = <0x02 0x0a 0x00>;
				default-state = "off";
				retain-state-suspended;
			};

			power_led_green {
				label = "power_led_green";
				gpios = <0x02 0x0c 0x00>;
				default-state = "on";
				retain-state-suspended;
			};

			wifi_led {
				label = "wifi_led";
				gpios = <0x02 0x0d 0x00>;
				default-state = "off";
				retain-state-suspended;
			};

			sled1 {
				label = "sled_led1";
				gpios = <0x02 0x31 0x00>;
				default-state = "off";
				retain-state-suspended;
			};

			sled2 {
				label = "sled_led2";
				gpios = <0x02 0x3d 0x00>;
				default-state = "off";
				retain-state-suspended;
			};

			sled3 {
				label = "sled_led3";
				gpios = <0x02 0x3f 0x00>;
				default-state = "off";
				retain-state-suspended;
			};

			sled4 {
				label = "sled_led4";
				gpios = <0x02 0x40 0x00>;
				default-state = "off";
				retain-state-suspended;
			};

			sms_led {
				label = "sms_led";
				gpios = <0x02 0x06 0x00>;
				default-state = "off";
				retain-state-suspended;
			};
		};

		regulator-isl80101 {
			compatible = "regulator-fixed";
			regulator-name = "ext_2p95v";
			gpio = <0x26 0x04 0x00>;
			enable-active-high;
			linux,phandle = <0x05>;
			phandle = <0x05>;
		};

		regulator-usb-vbus {
			compatible = "regulator-fixed";
			regulator-name = "usb_vbus";
			linux,phandle = <0x16>;
			phandle = <0x16>;
		};

		qcom,msm-imem@fe807800 {
			compatible = "qcom,msm-imem";
			reg = <0xfe807800 0x1000>;
		};

		android_usb@fe8078c8 {
			compatible = "qcom,android-usb";
			reg = <0xfe8078c8 0xc8>;
			qcom,android-usb-swfi-latency = <0x64>;
			qcom,android-usb-cdrom = <0x01>;
		};

		qca,wlan {
			cell-index = <0x00>;
			compatible = "qca,ar6004-hsic";
			qca,chip-pwd-l-gpios = <0x02 0x3e 0x00>;
			qca,pm-enable-gpios = <0x26 0x03 0x00>;
			qca,vdd-io-supply = <0x1d>;
		};

		qca,wlan_ar6003 {
			cell-index = <0x00>;
			compatible = "qca,ar6003-sdio";
			qca,chip-pwd-l-gpios = <0x02 0x3e 0x00>;
			qca,pm-enable-gpios = <0x26 0x03 0x00>;
			qca,vdd-io-supply = <0x1d>;
			qca,wifi-state-led = <0x27 0x01 0x00>;
			qca,wifi-state-led-green-r600 = <0x02 0x05 0x00>;
			qca,wifi-state-led-red-r600 = <0x02 0x0a 0x00>;
			qca,wifi-state-led-blue-r600 = <0x02 0x0b 0x00>;
		};

		gpio_keys {
			compatible = "gpio-keys";
			input-name = "gpio-keys";

			button0 {
				label = "GPIO KEY_WPS_BUTTON";
				gpios = <0x02 0x32 0x01>;
				linux,input-type = <0x01>;
				linux,code = <0x211>;
				gpio-key,wakeup;
				debounce-interval = <0x0f>;
			};
		};
	};
};
