/dts-v1/;

/ {
	#address-cells = <0x01>;
	#size-cells = <0x01>;
	model = "Qualcomm MSM 9625V2 MTP";
	compatible = "qcom,msm9625-mtp", "qcom,msm9625", "qcom,mtp";
	interrupt-parent = <0x01>;
	qcom,msm-id = <0x86 0x07 0x20000 0x98 0x07 0x20000 0x95 0x07 0x20000 0x96 0x07 0x20000 0x97 0x07 0x20000 0x94 0x07 0x20000 0xad 0x07 0x20000 0xae 0x07 0x20000 0xaf 0x07 0x20000>;

	chosen {
	};

	aliases {
		spi0 = "/soc/spi@f9923000";
	};

	memory {
		#address-cells = <0x01>;
		#size-cells = <0x01>;
		device_type = "memory";
		reg = <0x00 0x00>;
	};

	soc {
		#address-cells = <0x01>;
		#size-cells = <0x01>;
		ranges;

		qcom,ion {
			compatible = "qcom,msm-ion";
			#address-cells = <0x01>;
			#size-cells = <0x00>;

			qcom,ion-heap@30 {
				reg = <0x1e>;
			};

			qcom,ion-heap@25 {
				reg = <0x19>;
			};

			qcom,ion-heap@28 {
				compatible = "qcom,msm-ion-reserve";
				reg = <0x1c>;
				qcom,heap-align = <0x1000>;
				qcom,memory-reservation-type = "EBI1";
				qcom,memory-reservation-size = <0xe9000>;
			};
		};

		qcom,spm@f9009000 {
			compatible = "qcom,spm-v2";
			#address-cells = <0x01>;
			#size-cells = <0x01>;
			reg = <0xf9009000 0x1000>;
			qcom,core-id = <0x00>;
			qcom,saw2-ver-reg = <0xfd0>;
			qcom,saw2-cfg = <0x101>;
			qcom,saw2-spm-dly = <0x00>;
			qcom,saw2-spm-ctl = <0x01>;
			qcom,saw2-spm-cmd-wfi = <0x403040f>;
			qcom,saw2-spm-cmd-spc = [34 04 44 14 24 54 03 54 44 14 04 24 3e 0f];
			qcom,saw2-spm-cmd-pc = [34 04 44 14 24 54 07 54 44 14 04 24 3e 0f];
		};

		qcom,lpm-resources {
			compatible = "qcom,lpm-resources";
			#address-cells = <0x01>;
			#size-cells = <0x00>;

			qcom,lpm-resources@0 {
				reg = <0x00>;
				qcom,name = "vdd-dig";
				qcom,type = <0x616f646c>;
				qcom,id = <0x0a>;
				qcom,key = <0x6e726f63>;
				qcom,init-value = <0x05>;
			};

			qcom,lpm-resources@1 {
				reg = <0x01>;
				qcom,name = "vdd-mem";
				qcom,type = <0x616f646c>;
				qcom,id = <0x0c>;
				qcom,key = <0x7675>;
				qcom,init-value = <0x100590>;
			};

			qcom,lpm-resources@2 {
				reg = <0x02>;
				qcom,name = "pxo";
				qcom,type = <0x306b6c63>;
				qcom,id = <0x00>;
				qcom,key = <0x62616e45>;
				qcom,init-value = "xo_on";
			};
		};

		qcom,lpm-levels {
			compatible = "qcom,lpm-levels";
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			qcom,use-qtimer;

			qcom,lpm-level@0 {
				reg = <0x00>;
				qcom,mode = "wfi";
				qcom,xo = "xo_on";
				qcom,l2 = "l2_cache_active";
				qcom,vdd-mem-upper-bound = <0x100590>;
				qcom,vdd-mem-lower-bound = <0xe7ef0>;
				qcom,vdd-dig-upper-bound = <0x06>;
				qcom,vdd-dig-lower-bound = <0x04>;
				qcom,irqs-detectable;
				qcom,gpio-detectable;
				qcom,latency-us = <0x64>;
				qcom,ss-power = <0x1f40>;
				qcom,energy-overhead = <0x186a0>;
				qcom,time-overhead = <0x01>;
			};

			qcom,lpm-level@1 {
				reg = <0x01>;
				qcom,mode = "standalone_pc";
				qcom,xo = "xo_on";
				qcom,l2 = "l2_cache_active";
				qcom,vdd-mem-upper-bound = <0x100590>;
				qcom,vdd-mem-lower-bound = <0xe7ef0>;
				qcom,vdd-dig-upper-bound = <0x06>;
				qcom,vdd-dig-lower-bound = <0x04>;
				qcom,irqs-detectable;
				qcom,gpio-detectable;
				qcom,latency-us = <0x7d0>;
				qcom,ss-power = <0x1388>;
				qcom,energy-overhead = <0x3950da0>;
				qcom,time-overhead = <0xbb8>;
			};

			qcom,lpm-level@2 {
				reg = <0x02>;
				qcom,mode = "pc";
				qcom,xo = "xo_on";
				qcom,l2 = "l2_cache_gdhs";
				qcom,vdd-mem-upper-bound = <0x100590>;
				qcom,vdd-mem-lower-bound = <0xe7ef0>;
				qcom,vdd-dig-upper-bound = <0x06>;
				qcom,vdd-dig-lower-bound = <0x04>;
				qcom,irqs-detectable;
				qcom,gpio-detectable;
				qcom,latency-us = <0xdac>;
				qcom,ss-power = <0x1388>;
				qcom,energy-overhead = <0x398de30>;
				qcom,time-overhead = <0x189c>;
			};

			qcom,lpm-level@3 {
				reg = <0x03>;
				qcom,mode = "pc";
				qcom,xo = "xo_on";
				qcom,l2 = "l2_cache_pc";
				qcom,vdd-mem-upper-bound = <0x100590>;
				qcom,vdd-mem-lower-bound = <0xe7ef0>;
				qcom,vdd-dig-upper-bound = <0x04>;
				qcom,vdd-dig-lower-bound = <0x03>;
				qcom,irqs-detectable;
				qcom,gpio-detectable;
				qcom,latency-us = <0x1194>;
				qcom,ss-power = <0x1388>;
				qcom,energy-overhead = <0x398de30>;
				qcom,time-overhead = <0x1c84>;
			};

			qcom,lpm-level@4 {
				reg = <0x04>;
				qcom,mode = "pc";
				qcom,xo = "xo_off";
				qcom,l2 = "l2_cache_pc";
				qcom,vdd-mem-upper-bound = <0x100590>;
				qcom,vdd-mem-lower-bound = <0xe7ef0>;
				qcom,vdd-dig-upper-bound = <0x06>;
				qcom,vdd-dig-lower-bound = <0x04>;
				qcom,irqs-detectable;
				qcom,latency-us = <0x1a90>;
				qcom,ss-power = <0x7d0>;
				qcom,energy-overhead = <0x4485810>;
				qcom,time-overhead = <0x33f4>;
			};

			qcom,lpm-level@5 {
				reg = <0x05>;
				qcom,mode = "pc";
				qcom,xo = "xo_off";
				qcom,l2 = "l2_cache_pc";
				qcom,vdd-mem-upper-bound = <0x100590>;
				qcom,vdd-mem-lower-bound = <0xe7ef0>;
				qcom,vdd-dig-upper-bound = <0x06>;
				qcom,vdd-dig-lower-bound = <0x03>;
				qcom,irqs-detectable;
				qcom,latency-us = <0x1f40>;
				qcom,ss-power = <0x708>;
				qcom,energy-overhead = <0x449deb0>;
				qcom,time-overhead = <0x3bc4>;
			};

			qcom,lpm-level@6 {
				reg = <0x06>;
				qcom,mode = "pc";
				qcom,xo = "xo_off";
				qcom,l2 = "l2_cache_pc";
				qcom,vdd-mem-upper-bound = <0xe7ef0>;
				qcom,vdd-mem-lower-bound = <0xa4cb8>;
				qcom,vdd-dig-upper-bound = <0x03>;
				qcom,vdd-dig-lower-bound = <0x01>;
				qcom,latency-us = <0x2648>;
				qcom,ss-power = <0x00>;
				qcom,energy-overhead = <0x48d0230>;
				qcom,time-overhead = <0x6e8c>;
			};
		};

		qcom,pm-boot {
			compatible = "qcom,pm-boot";
			qcom,mode = "tz";
		};

		qcom,mpm@fc4281d0 {
			compatible = "qcom,mpm-v2";
			reg = <0xfc4281d0 0x1000 0xf9011008 0x04>;
			reg-names = "vmpm", "ipc";
			interrupts = <0x00 0xab 0x01>;
			qcom,ipc-bit-offset = <0x01>;
			qcom,gic-parent = <0x01>;
			qcom,gic-map = <0x02 0xd8 0x2f 0xac 0x29 0xb4 0x3e 0xde 0xff 0x39 0xff 0x3a 0xff 0x3b 0xff 0x3c 0xff 0xad 0xff 0xae 0xff 0xaf 0xff 0xb0 0xff 0xb1 0xff 0xb2 0xff 0xb3 0xff 0xbc 0xff 0xbd 0xff 0xbe 0xff 0xbf 0xff 0xc0 0xff 0xc1 0xff 0xc2 0xff 0xc3 0xff 0xc4 0xff 0xc5 0xff 0xc8 0xff 0xc9 0xff 0xca 0xff 0xcb 0xff 0xcc 0xff 0xcd 0xff 0xce 0xff 0xcf 0xff 0xf0>;
			qcom,gpio-parent = <0x02>;
			qcom,gpio-map = <0x04 0x00 0x05 0x01 0x06 0x02 0x07 0x03 0x08 0x04 0x09 0x05 0x0a 0x06 0x0b 0x07 0x0c 0x08 0x0d 0x09 0x0e 0x0a 0x0f 0x0b 0x10 0x0c 0x11 0x0d 0x12 0x0e 0x13 0x0f 0x14 0x10 0x15 0x11 0x16 0x12 0x17 0x13 0x18 0x14 0x19 0x15 0x1a 0x18 0x1b 0x19 0x1c 0x33 0x1d 0x3d 0x1e 0x3e 0x1f 0x3f 0x20 0x40 0x21 0x41 0x22 0x42 0x23 0x43 0x24 0x45 0x25 0x47>;
		};

		qcom,pm-8x60 {
			compatible = "qcom,pm-8x60";
			qcom,pc-mode = "tz_l2_ext";
			qcom,use-sync-timer;
		};

		qcom,rpm-log@fc19dc00 {
			compatible = "qcom,rpm-log";
			reg = <0xfc19dc00 0x4000>;
			qcom,rpm-addr-phys = <0xfc000000>;
			qcom,offset-version = <0x04>;
			qcom,offset-page-buffer-addr = <0x24>;
			qcom,offset-log-len = <0x28>;
			qcom,offset-log-len-mask = <0x2c>;
			qcom,offset-page-indices = <0x38>;
		};

		qcom,rpm-stats@fc19dba0 {
			compatible = "qcom,rpm-stats";
			reg = <0xfc19dba0 0x1000>;
			reg-names = "phys_addr_base";
			qcom,sleep-stats-version = <0x02>;
		};

		awinic,aw3215 {
			compatible = "awinic,aw3215";
			interrupt-parent = <0x02>;
			interrupts = <0x0e 0x03 0x17 0x03>;
			msm9625,battery-ctrl-gpio = <0x02 0x0e 0x01>;
			msm9625,battery-stat-gpio = <0x02 0x17 0x00>;
			status = "ok";
		};

		tmc@fc322000 {
			compatible = "arm,coresight-tmc";
			reg = <0xfc322000 0x1000 0xfc37c000 0x3000>;
			reg-names = "tmc-base", "bam-base";
			qcom,memory-reservation-type = "EBI1";
			qcom,memory-reservation-size = <0x20000>;
			coresight-id = <0x00>;
			coresight-name = "coresight-tmc-etr";
			coresight-nr-inports = <0x01>;
			coresight-ctis = <0x03 0x04>;
			linux,phandle = <0x06>;
			phandle = <0x06>;
		};

		tpiu@fc318000 {
			compatible = "arm,coresight-tpiu";
			reg = <0xfc318000 0x1000>;
			reg-names = "tpiu-base";
			coresight-id = <0x01>;
			coresight-name = "coresight-tpiu";
			coresight-nr-inports = <0x01>;
			vdd-supply = <0x05>;
			linux,phandle = <0x07>;
			phandle = <0x07>;
		};

		replicator@fc31c000 {
			compatible = "qcom,coresight-replicator";
			reg = <0xfc31c000 0x1000>;
			reg-names = "replicator-base";
			coresight-id = <0x02>;
			coresight-name = "coresight-replicator";
			coresight-nr-inports = <0x01>;
			coresight-outports = <0x00 0x01>;
			coresight-child-list = <0x06 0x07>;
			coresight-child-ports = <0x00 0x00>;
			linux,phandle = <0x08>;
			phandle = <0x08>;
		};

		tmc@fc307000 {
			compatible = "arm,coresight-tmc";
			reg = <0xfc307000 0x1000>;
			reg-names = "tmc-base";
			coresight-id = <0x03>;
			coresight-name = "coresight-tmc-etf";
			coresight-nr-inports = <0x01>;
			coresight-outports = <0x00>;
			coresight-child-list = <0x08>;
			coresight-child-ports = <0x00>;
			coresight-default-sink;
			coresight-ctis = <0x03 0x04>;
			linux,phandle = <0x09>;
			phandle = <0x09>;
		};

		funnel@fc31b000 {
			compatible = "arm,coresight-funnel";
			reg = <0xfc31b000 0x1000>;
			reg-names = "funnel-base";
			coresight-id = <0x04>;
			coresight-name = "coresight-funnel-merg";
			coresight-nr-inports = <0x02>;
			coresight-outports = <0x00>;
			coresight-child-list = <0x09>;
			coresight-child-ports = <0x00>;
			linux,phandle = <0x0a>;
			phandle = <0x0a>;
		};

		funnel@fc319000 {
			compatible = "arm,coresight-funnel";
			reg = <0xfc319000 0x1000>;
			reg-names = "funnel-base";
			coresight-id = <0x05>;
			coresight-name = "coresight-funnel-in0";
			coresight-nr-inports = <0x08>;
			coresight-outports = <0x00>;
			coresight-child-list = <0x0a>;
			coresight-child-ports = <0x00>;
			linux,phandle = <0x0c>;
			phandle = <0x0c>;
		};

		funnel@fc31a000 {
			compatible = "arm,coresight-funnel";
			reg = <0xfc31a000 0x1000>;
			reg-names = "funnel-base";
			coresight-id = <0x06>;
			coresight-name = "coresight-funnel-in1";
			coresight-nr-inports = <0x08>;
			coresight-outports = <0x00>;
			coresight-child-list = <0x0a>;
			coresight-child-ports = <0x01>;
			linux,phandle = <0x0b>;
			phandle = <0x0b>;
		};

		stm@fc321000 {
			compatible = "arm,coresight-stm";
			reg = <0xfc321000 0x1000 0xfa280000 0x180000>;
			reg-names = "stm-base", "stm-data-base";
			coresight-id = <0x07>;
			coresight-name = "coresight-stm";
			coresight-nr-inports = <0x00>;
			coresight-outports = <0x00>;
			coresight-child-list = <0x0b>;
			coresight-child-ports = <0x07>;
		};

		etm@fc332000 {
			compatible = "arm,coresight-etm";
			reg = <0xfc332000 0x1000>;
			reg-names = "etm-base";
			coresight-id = <0x08>;
			coresight-name = "coresight-etm0";
			coresight-nr-inports = <0x00>;
			coresight-outports = <0x00>;
			coresight-child-list = <0x0c>;
			coresight-child-ports = <0x04>;
			qcom,round-robin;
		};

		csr@fc302000 {
			compatible = "qcom,coresight-csr";
			reg = <0xfc302000 0x1000>;
			reg-names = "csr-base";
			coresight-id = <0x09>;
			coresight-name = "coresight-csr";
			coresight-nr-inports = <0x00>;
			qcom,blk-size = <0x01>;
		};

		cti@fc308000 {
			compatible = "arm,coresight-cti";
			reg = <0xfc308000 0x1000>;
			reg-names = "cti-base";
			coresight-id = <0x0a>;
			coresight-name = "coresight-cti0";
			coresight-nr-inports = <0x00>;
			linux,phandle = <0x03>;
			phandle = <0x03>;
		};

		cti@fc309000 {
			compatible = "arm,coresight-cti";
			reg = <0xfc309000 0x1000>;
			reg-names = "cti-base";
			coresight-id = <0x0b>;
			coresight-name = "coresight-cti1";
			coresight-nr-inports = <0x00>;
		};

		cti@fc30a000 {
			compatible = "arm,coresight-cti";
			reg = <0xfc30a000 0x1000>;
			reg-names = "cti-base";
			coresight-id = <0x0c>;
			coresight-name = "coresight-cti2";
			coresight-nr-inports = <0x00>;
		};

		cti@fc30b000 {
			compatible = "arm,coresight-cti";
			reg = <0xfc30b000 0x1000>;
			reg-names = "cti-base";
			coresight-id = <0x0d>;
			coresight-name = "coresight-cti3";
			coresight-nr-inports = <0x00>;
		};

		cti@fc30c000 {
			compatible = "arm,coresight-cti";
			reg = <0xfc30c000 0x1000>;
			reg-names = "cti-base";
			coresight-id = <0x0e>;
			coresight-name = "coresight-cti4";
			coresight-nr-inports = <0x00>;
		};

		cti@fc30d000 {
			compatible = "arm,coresight-cti";
			reg = <0xfc30d000 0x1000>;
			reg-names = "cti-base";
			coresight-id = <0x0f>;
			coresight-name = "coresight-cti5";
			coresight-nr-inports = <0x00>;
		};

		cti@fc30e000 {
			compatible = "arm,coresight-cti";
			reg = <0xfc30e000 0x1000>;
			reg-names = "cti-base";
			coresight-id = <0x10>;
			coresight-name = "coresight-cti6";
			coresight-nr-inports = <0x00>;
		};

		cti@fc30f000 {
			compatible = "arm,coresight-cti";
			reg = <0xfc30f000 0x1000>;
			reg-names = "cti-base";
			coresight-id = <0x11>;
			coresight-name = "coresight-cti7";
			coresight-nr-inports = <0x00>;
		};

		cti@fc310000 {
			compatible = "arm,coresight-cti";
			reg = <0xfc310000 0x1000>;
			reg-names = "cti-base";
			coresight-id = <0x12>;
			coresight-name = "coresight-cti8";
			coresight-nr-inports = <0x00>;
			linux,phandle = <0x04>;
			phandle = <0x04>;
		};

		cti@fc333000 {
			compatible = "arm,coresight-cti";
			reg = <0xfc333000 0x1000>;
			reg-names = "cti-base";
			coresight-id = <0x13>;
			coresight-name = "coresight-cti-cpu";
			coresight-nr-inports = <0x00>;
		};

		hwevent@f9011038 {
			compatible = "qcom,coresight-hwevent";
			reg = <0xf9011038 0x08 0xfd4ab160 0x80>;
			reg-names = "apcs-mux", "ppss-mux";
			coresight-id = <0x14>;
			coresight-name = "coresight-hwevent";
			coresight-nr-inports = <0x00>;
		};

		qcom,smp2p-modem {
			compatible = "qcom,smp2p";
			reg = <0xf9011008 0x04>;
			qcom,remote-pid = <0x01>;
			qcom,irq-bitmask = <0x4000>;
			interrupts = <0x00 0x1b 0x01>;
		};

		qcom,smp2p-adsp {
			compatible = "qcom,smp2p";
			reg = <0xf9011008 0x04>;
			qcom,remote-pid = <0x02>;
			qcom,irq-bitmask = <0x400>;
			interrupts = <0x00 0x9e 0x01>;
		};

		qcom,smp2pgpio-smp2p-7-in {
			compatible = "qcom,smp2pgpio";
			qcom,entry-name = "smp2p";
			qcom,remote-pid = <0x07>;
			qcom,is-inbound;
			gpio-controller;
			#gpio-cells = <0x02>;
			interrupt-controller;
			#interrupt-cells = <0x02>;
			linux,phandle = <0x0d>;
			phandle = <0x0d>;
		};

		qcom,smp2pgpio_test_smp2p_7_in {
			compatible = "qcom,smp2pgpio_test_smp2p_7_in";
			gpios = <0x0d 0x00 0x00>;
		};

		qcom,smp2pgpio-smp2p-7-out {
			compatible = "qcom,smp2pgpio";
			qcom,entry-name = "smp2p";
			qcom,remote-pid = <0x07>;
			gpio-controller;
			#gpio-cells = <0x02>;
			interrupt-controller;
			#interrupt-cells = <0x02>;
			linux,phandle = <0x0e>;
			phandle = <0x0e>;
